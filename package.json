{
  "name": "tani-desa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --import tsx apps/server/src/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && vite build && tsup apps/server/src/index.ts --format esm --out-dir dist/server --clean --sourcemap --external sharp && tsup scripts/migrate.ts scripts/bootstrap.ts scripts/provision.ts scripts/reminders.ts scripts/verify-ledger.ts --format esm --out-dir dist/tools --clean --external sharp",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests --max-warnings 0",
    "test": "vitest run --no-file-parallelism",
    "test:postgres": "vitest run tests/postgres.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "bootstrap": "node --import tsx scripts/bootstrap.ts",
    "organization:create": "node --import tsx scripts/provision.ts",
    "reminders": "node --import tsx scripts/reminders.ts",
    "inventory:verify": "node --import tsx scripts/verify-ledger.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "jobs": "node --import tsx scripts/reminders.ts",
    "db:migrate:prod": "node dist/tools/migrate.js",
    "bootstrap:prod": "node dist/tools/bootstrap.js",
    "organization:create:prod": "node dist/tools/provision.js",
    "jobs:prod": "node dist/tools/reminders.js",
    "inventory:verify:prod": "node dist/tools/verify-ledger.js",
    "api:generate": "node --import tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@tanstack/react-query": "^5.90.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.28.2": true
  }
}
