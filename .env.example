# No secrets or real account credentials belong in this file.
NODE_ENV=development
PORT=3000
# Exact browser origin; localhost:5173 for npm run dev, HTTPS origin in production.
APP_URL=http://localhost:5173
# Optional canonical HTTPS origin, e.g. https://your-real-domain.id. Leave empty until deployment.
SITE_URL=
# Neon pooled URL, including sslmode=verify-full (or provider-required SSL settings).
# For local PostgreSQL use an explicitly created database and your own password.
DATABASE_URL=
# Optional direct Neon URL for DDL; defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Set to the slug intentionally provisioned through organization:create.
PUBLIC_ORG_SLUG=
# 0 without a proxy. Set the EXACT trusted reverse-proxy hop count in deployment.
TRUST_PROXY_HOPS=0

# Brevo transactional email: verified sender required. Server only.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Tani Desa

# Filebase S3-compatible storage. Server-side credentials only.
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
FILEBASE_BUCKET=

# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: monitored contact email, or HTTPS contact URL.
VAPID_SUBJECT=
# Firebase Admin SDK credential file. Server only; never commit the JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
# In-process worker every minute handles durable password-reset requests.
BACKGROUND_WORKER_ENABLED=true
# Controls sales-reminder work inside the same worker.
REMINDER_WORKER_ENABLED=true
# If background worker is false, schedule npm run jobs at least every minute.

# LOCAL compose only, choose strong values; not used by Neon.
LOCAL_DB_PASSWORD=
TEST_DB_PASSWORD=
# Optional dedicated PostgreSQL testing database, name MUST end with _test.
TEST_DATABASE_URL=

# Bootstrap/provisioning variables should be supplied only for the intentional
# command, then removed. Never configure them in the application service.
# BOOTSTRAP_CONFIRM=CREATE_SUPER_ADMIN
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_NAME=
# BOOTSTRAP_PASSWORD=
# PROVISION_CONFIRM=CREATE_ORGANIZATION
# PLATFORM_EMAIL=
# PLATFORM_PASSWORD=
# ORG_NAME=
# ORG_SLUG=
# OWNER_EMAIL=
# OWNER_NAME=
# OWNER_PASSWORD=
